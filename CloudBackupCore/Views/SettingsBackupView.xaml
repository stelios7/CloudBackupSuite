<Window
	x:Class="Cloud_Backup_Core.Views.SettingsBackupView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Cloud_Backup_Core.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="SettingsBackupView"
	Style="{StaticResource SettingsWindowStyle}"
	WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<Window.Resources>
		<Style BasedOn="{StaticResource SettingsWindowButton}" TargetType="Button" />
		<Style BasedOn="{StaticResource SettingsGroupBox}" TargetType="GroupBox" />
		<Style TargetType="TextBlock">
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Width" Value="auto" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,0,5,0" />
		</Style>
	</Window.Resources>
	<StackPanel Margin="10">
		<GroupBox Header="Backup Settings">
			<StackPanel>
				<!--  Backup Folder Selection  -->
				<TextBlock Text="Backup Folder:" />
				<StackPanel Margin="0,5,0,10" Orientation="Horizontal">
					<TextBox Width="350" Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" />
					<Button
						Margin="5,0,0,0"
						Command="{Binding BrowseCommand}"
						Content="Browse..."
						Style="{StaticResource MenuBarButton2}" />
				</StackPanel>

				<!--  SQL Server Instance Name  -->
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="SQL Server Instance:" />
					<TextBox
						x:Name="txtSqlServer"
						Width="250"
						Margin="0,5,0,5"
						HorizontalAlignment="Left"
						Text="{Binding SqlServerName, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>

				<StackPanel Orientation="Horizontal">
					<TextBlock Text="Username:" />
					<TextBox
						x:Name="txtSqlUsername"
						Width="150"
						Margin="0,5,0,5"
						HorizontalAlignment="Left"
						Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Text="Password:" />
					<TextBox
						x:Name="txtSqlPassword"
						Width="150"
						Margin="0,5,0,5"
						HorizontalAlignment="Left"
						Text="{Binding SqlPassword, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>

				<!--  Database Name Input  -->
				<TextBlock Text="Database Name:" />
				<TextBox
					x:Name="txtDatabaseName"
					Width="350"
					Margin="0,5,0,10"
					HorizontalAlignment="Left"
					Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" />

				<!--  Backup Now Button  -->
				<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
					<Button Command="{Binding BackupCommand}" Content="Backup Now" />
				</StackPanel>

				<!--  Backup Status  -->
				<StackPanel Orientation="Horizontal">
					<TextBlock x:Name="lblStatus" Text="Status: " />
					<TextBlock
						Margin="0,10,0,0"
						FontWeight="Bold"
						Text="{Binding StatusMessage}" />
				</StackPanel>
			</StackPanel>
		</GroupBox>

		<!--  Auto Backup Settings  -->
		<GroupBox Header="Αυτόματο Backup">
			<StackPanel Margin="10">
				<StackPanel Margin="0,5" Orientation="Horizontal">
					<TextBlock
						Margin="0,0,10,0"
						VerticalAlignment="Center"
						Text="Χρονικό διάστημα ελέγχου (δευτερόλεπτα):" />
					<TextBox Width="100" Text="{Binding AutoBackupInterval}" />
				</StackPanel>

				<CheckBox
					Margin="0,5"
					Content="Ενεργοποίηση αυτόματου backup"
					IsChecked="{Binding IsAutoBackupEnabled}" />

				<!--  Schedule Backup  -->
				<TextBlock Text="Schedule Backup (Daily at HH:mm):" />
				<StackPanel Orientation="Horizontal">
					<TextBox
						x:Name="txtScheduleTime"
						Width="50"
						HorizontalContentAlignment="Center"
						Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}" />
					<Button
						Margin="10,0,0,0"
						Command="{Binding SetScheduleCommand}"
						Content="Set Schedule"
						Style="{StaticResource MenuBarButton2}" />
				</StackPanel>

			</StackPanel>
		</GroupBox>
				<!--  Save Button  -->
				<Button
					HorizontalAlignment="Left"
					Command="{Binding SaveBackupSettingsCommand}"
					Content="Save Settings" />
	</StackPanel>

</Window>
