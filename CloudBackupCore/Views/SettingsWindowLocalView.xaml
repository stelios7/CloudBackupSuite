<Window x:Class="Cloud_Backup_Core.Views.SettingsWindowLocalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cloud_Backup_Core.Views"
        mc:Ignorable="d"
        Title="Ρυθμίσεις Εφαρμογής" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
		>
	<Window.Resources>
		<Style TargetType="GroupBox">
			<Setter Property="Background" Value="{StaticResource BackgroundMainBrush}" />

			<Setter Property="HeaderTemplate">
				<Setter.Value>
					<DataTemplate>
						<Border Background="{StaticResource AccentColorBrush}" Padding="5" CornerRadius="2" Height="20" Margin="0" >
							<TextBlock Text="{Binding}" 
									   Margin="0" Padding="0"
									   FontSize="8"
									   FontWeight="Bold" 
									   FontStyle="Italic"
									   Foreground="{StaticResource MutedBlueBrush}"/>
						</Border>
					</DataTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<StackPanel Margin="20" Orientation="Vertical" VerticalAlignment="Top">

		<!-- Auto Backup Settings -->
		<GroupBox Header="Αυτόματο Backup" Margin="0 0 0 10">
			<StackPanel Margin="10">
				<StackPanel Orientation="Horizontal" Margin="0 5">
					<TextBlock Text="Χρονικό διάστημα ελέγχου (δευτερόλεπτα):" VerticalAlignment="Center" Margin="0 0 10 0"/>
					<TextBox Width="100" Text="{Binding AutoBackupInterval}" />
				</StackPanel>

				<CheckBox Content="Ενεργοποίηση αυτόματου backup"
                          IsChecked="{Binding IsAutoBackupEnabled}" Margin="0 5"/>
			</StackPanel>
		</GroupBox>

		<!-- File Handling -->
		<GroupBox Header="Διαχείριση Αρχείων" Margin="0 0 0 10">
			<StackPanel Margin="10">
				<CheckBox Content="Διαγραφή τοπικού αρχείου μετά την επιτυχή μεταφόρτωση"
                          IsChecked="{Binding DeleteLocalAfterUpload}" Margin="0 5"/>
				<CheckBox Content="Διατήρηση αντιγράφου ασφαλείας σε τοπικό φάκελο"
                          IsChecked="{Binding KeepLocalBackup}" Margin="0 5"/>
				<StackPanel Orientation="Horizontal" Margin="0 5">
					<TextBlock Text="Όριο μεγέθους προς ανέβασμα (MB):" VerticalAlignment="Center" Margin="0 0 10 0"/>
					<TextBox Width="100" Text="{Binding MaxUploadSizeMB}" />
				</StackPanel>
			</StackPanel>
		</GroupBox>

		<!-- Notifications & Logging -->
		<GroupBox Header="Ειδοποιήσεις και Καταγραφή" Margin="0 0 0 10">
			<StackPanel Margin="10">
				<CheckBox Content="Ειδοποίηση για αποτυχημένο ανέβασμα"
                          IsChecked="{Binding NotifyOnFailure}" Margin="0 5"/>
				<CheckBox Content="Εμφάνιση καταγραφής ενεργειών (log)"
                          IsChecked="{Binding ShowLogs}" Margin="0 5"/>
			</StackPanel>
		</GroupBox>

		<!-- Startup -->
		<GroupBox Header="Εκκίνηση" Margin="0 0 0 10">
			<StackPanel Margin="10">
				<CheckBox Content="Εκκίνηση με τα Windows"
                          IsChecked="{Binding StartWithWindows}" Margin="0 5"/>
			</StackPanel>

		</GroupBox>
		<Button Content="Αποθήκευση" 
				Margin="0 10 0 0"
                HorizontalAlignment="Center"
                Command="{Binding SaveCommand}" 
				Style="{StaticResource SettingsWindowButton}"
				/>


	</StackPanel>
</Window>
