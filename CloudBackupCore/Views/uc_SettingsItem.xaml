<UserControl
	x:Class="Cloud_Backup_Core.Views.uc_SettingsItem"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Width="350"
	Height="25"
	Margin="2"
	mc:Ignorable="d">
	<UserControl.Resources>
		<Style BasedOn="{StaticResource SettingsControlBorder}" TargetType="Border" />
	</UserControl.Resources>
	<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
		<!--  Checkbox  -->
		<CheckBox
			x:Name="EnableCheckbox"
			Margin="0"
			VerticalAlignment="Center"
			FontSize="14"
			IsChecked="{Binding UploadEnabled}" />

		<!--  Text="{Binding DataContext.SoftwareName, RelativeSource={RelativeSource AncestorType=CheckBox}, UpdateSourceTrigger=PropertyChanged}"  -->
		<TextBox
			MinWidth="80"
			MaxWidth="120"
			Margin="5,0,5,0"
			VerticalContentAlignment="Center"
			Background="Transparent"
			BorderThickness="0"
			FontSize="12"
			Text="{Binding SoftwareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<!--  TextBox  -->
		<TextBox
			x:Name="PathTextBox"
			Width="250"
			Background="White"
			FontSize="12"
			IsEnabled="{Binding IsChecked, ElementName=EnableCheckbox}"
			Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
	</StackPanel>
</UserControl>
