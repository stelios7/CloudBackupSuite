<Window x:Class="Cloud_Backup_Core.Views.SettingsWindowFtpView"  
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
      xmlns:conv="clr-namespace:Cloud_Backup_Core.Helpers"  
      xmlns:uc="clr-namespace:Cloud_Backup_Core.Views" 
      mc:Ignorable="d"  
      Title="Ρυθμίσεις"  
      Height="600" MinHeight="600" MaxHeight="600"  
      Width="440" MaxWidth="440" MinWidth="440"  
      WindowStartupLocation="CenterScreen"  
      WindowStyle="ToolWindow"
		Style="{StaticResource MainWindowStyle}">
	<Window.Resources>
		<Style TargetType="GroupBox">
			<Setter Property="FontSize" Value="12" />
		</Style>
	</Window.Resources>
	<Grid>
		<Grid.Resources>
			<Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextbox}" />
			<Style TargetType="Border">
				<Setter Property="CornerRadius" Value="5" />
				<Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Margin" Value="0" />
				<Setter Property="Background" Value="Transparent" />
			</Style>
		</Grid.Resources>
		<DockPanel LastChildFill="True" Margin="10" HorizontalAlignment="Center">
			<StackPanel Orientation="Vertical" DockPanel.Dock="Left">
				<ItemsControl ItemsSource="{Binding UploadSettings}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<uc:uc_SettingsItem DataContext="{Binding}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Label Content="ΑΦΜ: " Foreground="#2C3930" />
					<Border Width="150" CornerRadius="5" BorderBrush="#D6BD98" BorderThickness="1" Margin="2"  
                          Background="White">
						<StackPanel Orientation="Horizontal">
							<TextBox FontSize="12"  
                                   Height="auto" VerticalAlignment="Center"  
                                   VerticalContentAlignment="Center"  
                                   HorizontalContentAlignment="Center"  
                                   Foreground="#677D6A"  
                                   Background="Transparent"  
                                   BorderThickness="0" Padding="0"  
                                   Width="150"  
                                   Text="{Binding SoftwareName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
						</StackPanel>
					</Border>
				</StackPanel>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Button Content="Save" Margin="10" Width="100" Height="30" Command="{Binding SaveCommand}"  
                          Style="{StaticResource StyledButton}" />
				</StackPanel>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
