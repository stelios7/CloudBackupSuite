<Window
	x:Class="Cloud_Backup_Core.Views.SettingsWindowFtpView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="clr-namespace:Cloud_Backup_Core.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:uc="clr-namespace:Cloud_Backup_Core.Views"
	Title="Ρυθμίσεις"
	Style="{StaticResource SettingsWindowStyle}"
	WindowStartupLocation="CenterScreen"
	WindowStyle="ToolWindow"
	mc:Ignorable="d">

	<Window.Resources>

		<Style BasedOn="{StaticResource SettingsGroupBox}" TargetType="GroupBox">
			<Setter Property="Width" Value="400" />
		</Style>
		<Style BasedOn="{StaticResource SettingsTextbox}" TargetType="TextBox">
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="14" />
		</Style>
		<Style BasedOn="{StaticResource SettingsControlBorder}" TargetType="Border">
			<Setter Property="CornerRadius" Value="0" />
		</Style>
		<Style BasedOn="{StaticResource SettingsPasswordBox}" TargetType="PasswordBox">
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="FontSize" Value="14" />
		</Style>
	</Window.Resources>

	<StackPanel
		Margin="5"
		HorizontalAlignment="Center"
		Orientation="Vertical">

		<!--  Toggle default FTP config  -->
		<!--<CheckBox
			Margin="0,0,0,5"
			HorizontalAlignment="Left"
			Content="Use Default FTP Settings"
			IsChecked="{Binding IsUsingDefaultSettings, Mode=TwoWay}" />-->

		<!--  FTP Connection Settings  -->
		<GroupBox Header="FTP Connection">
			<StackPanel Margin="5" Orientation="Vertical">

				<!--  SERVER ADDRESS  -->
				<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
					<TextBlock
						Width="80"
						VerticalAlignment="Center"
						Text="Server Address:" />
					<Border Width="250" Margin="20,1,0,0">
						<TextBox Text="{Binding FtpServerAddress, UpdateSourceTrigger=PropertyChanged}" />
					</Border>
				</StackPanel>

				<!--  FTP USERNAME  -->
				<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
					<TextBlock
						Width="80"
						Margin="0,5,0,0"
						Text="Username:" />
					<Border Width="250" Margin="20,1,0,0">
						<TextBox Text="{Binding FtpUsername, UpdateSourceTrigger=PropertyChanged}" />
					</Border>
				</StackPanel>

				<!--  FTP PASSWORD  -->
				<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
					<TextBlock
						Width="80"
						Margin="0,5,0,0"
						Text="Password:" />
					<Border Width="250" Margin="20,1,0,0">
						<PasswordBox
							x:Name="PasswordBox"
							HorizontalAlignment="Stretch"
							helpers:PasswordBoxHelper.BoundPassword="{Binding Path=FtpPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					</Border>
				</StackPanel>

				<!--  FTP PORT  -->
				<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
					<TextBlock
						Width="80"
						Margin="0,5,0,0"
						Text="Port:" />
					<Border Width="100" Margin="20,1,0,0">
						<TextBox Text="{Binding FtpPort, UpdateSourceTrigger=PropertyChanged}" />
					</Border>

					<!--  TEST FTP CONNECTION  -->
					<Button
						Height="30"
						Margin="0,4,0,0"
						Padding="20,0"
						VerticalAlignment="Center"
						VerticalContentAlignment="Center"
						Command="{Binding TestFtpConnectionCommand}"
						Content="Test FTP Connection"
						Style="{StaticResource MenuBarButton2}" />
				</StackPanel>
			</StackPanel>
		</GroupBox>

		<!--  Upload Settings  -->
		<GroupBox
			MaxHeight="250"
			Margin="0"
			Header="Upload Settings">
			<StackPanel>
				<!--  Buttons to add and remove items  -->
				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
					<Button
						Command="{Binding AddUploadSettingCommand}"
						Content="Add"
						Style="{StaticResource MenuBarButton2}" />
					<Button
						Command="{Binding RemoveUploadSettingCommand}"
						Content="Remove"
						Style="{StaticResource MenuBarButton2}" />
				</StackPanel>
				<ItemsControl HorizontalContentAlignment="Center" ItemsSource="{Binding UploadSettings}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<uc:uc_SettingsItem DataContext="{Binding}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</GroupBox>

		<!--  Identification  -->
		<GroupBox Margin="0,10,0,0" Header="Identification">
			<StackPanel HorizontalAlignment="center" Orientation="Horizontal">
				<Label VerticalAlignment="Center" Content="ΑΦΜ:" />
				<TextBox Width="200" Text="{Binding RegisteredName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
			</StackPanel>
		</GroupBox>

		<!--  Save Button  -->
		<StackPanel
			Margin="0,10,0,0"
			HorizontalAlignment="Center"
			Orientation="Horizontal">
			<Button
				Width="100"
				Height="30"
				Command="{Binding SaveCommand}"
				Content="Save"
				Style="{StaticResource SettingsWindowButton}" />
		</StackPanel>

	</StackPanel>
</Window>
