<Application
	x:Class="Cloud_Backup_Core.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:System="clr-namespace:System;assembly=mscorlib"
	xmlns:local="clr-namespace:Cloud_Backup_Core"
	StartupUri="MainWindow.xaml">
	<Application.Resources>
		<System:Double x:Key="ControlHeight30">30</System:Double>

		<SolidColorBrush x:Key="ReadOnlyTextBrush" Color="#D6BD98" />
		<SolidColorBrush x:Key="DarkForeground" Color="#2C3930" />
		<SolidColorBrush x:Key="WindowBackground" Color="#DCD7C9" />

		<!--
			AccentColor → #0096C7 (A vibrant teal for highlighting important elements)
			BorderColor → #BDBDBD (A subtle gray for borders and dividers)
			ErrorColor → #D32F2F (A muted red for errors and warnings)
			SuccessColor → #2E7D32 (A refined green for success notifications)
			DisabledButtonColor → #A3A3A3 (A softened gray for inactive buttons)
			HighlightColor → #FFC107 (A warm yellow for key indicators)
			ShadowColor → #9E9E9E (A soft gray for UI depth effects)
			Light Gray (#F4F4F4) – Subtle, neutral, and easy on the eyes.
			Soft White (#FAFAFA) – Clean and modern, great for contrast with dark text.
			Muted Blue (#E3F2FD) – Slightly cool-toned, works well for professional apps.
		-->

		<Color x:Key="BackgroundMainColor">#F4F4F4</Color>
		<Color x:Key="TextColor">#333333</Color>
		<Color x:Key="PrimaryButtonColor">#005A9E</Color>
		<Color x:Key="PrimaryButtonTextColor">#FFFFFF</Color>
		<Color x:Key="SecondaryButtonColor">#D6D6D6</Color>
		<Color x:Key="SecondaryButtonTextColor">#333333</Color>
		<Color x:Key="ButtonHoverColor">#0071C5</Color>
		<Color x:Key="AccentColor">#0096C7</Color>
		<Color x:Key="MutedBlue">#E3F2FD</Color>

		<SolidColorBrush x:Key="BackgroundMainBrush" Color="{StaticResource BackgroundMainColor}" />
		<SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
		<SolidColorBrush x:Key="PrimaryButtonBrush" Color="{StaticResource PrimaryButtonColor}" />
		<SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="{StaticResource PrimaryButtonTextColor}" />
		<SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}" />
		<SolidColorBrush x:Key="SecondaryButtonTextBrush" Color="{StaticResource SecondaryButtonTextColor}" />
		<SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
		<SolidColorBrush x:Key="AccentColorBrush" Color="{StaticResource AccentColor}" />
		<SolidColorBrush x:Key="MutedBlueBrush" Color="{StaticResource MutedBlue}" />

		<Style TargetType="Control">
			<Setter Property="Foreground" Value="{StaticResource TextBrush}" />
		</Style>

		<Style x:Key="SettingsControlBorder" TargetType="Border">
			<Setter Property="CornerRadius" Value="5" />
			<Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style x:Key="StyledButton" TargetType="Button">
			<Setter Property="Background" Value="#677D6A" />
			<Setter Property="Foreground" Value="#DCD7C9" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="Padding" Value="5" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="#D6BD98" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
			<Setter Property="Foreground" Value="{StaticResource PrimaryButtonTextBrush}" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="Padding" Value="10" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="#D6BD98" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Width" Value="200" />
			<Setter Property="Height" Value="40" />
			<Setter Property="Margin" Value="5" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#0071C5" />
								<Setter Property="Foreground" Value="#FFFFFF" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" Value="#005A9E" />
								<Setter Property="Foreground" Value="#F4F4F4" />
								<Setter Property="FontWeight" Value="Bold" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MenuBarButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource WindowBackground}" />
			<Setter Property="Foreground" Value="{StaticResource DarkForeground}" />
			<Setter Property="FontSize" Value="9" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Width" Value="auto" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border
							Margin="2"
							Padding="2"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="2">
							<ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#D6BD98" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Foreground" Value="{StaticResource DarkForeground}" />
								<Setter Property="FontWeight" Value="SemiBold" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MenuBarButton2" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{StaticResource DarkForeground}" />
			<!--  Darker foreground  -->
			<Setter Property="FontSize" Value="10" />
			<Setter Property="Height" Value="20" />
			<Setter Property="Padding" Value="2,0" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Cursor" Value="Hand" />

		</Style>

		<Style x:Key="SettingsWindowButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
			<Setter Property="Foreground" Value="{StaticResource PrimaryButtonTextBrush}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Width" Value="120" />
			<Setter Property="Height" Value="{StaticResource ControlHeight30}" />
			<Setter Property="Padding" Value="10" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="#D6BD98" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Margin" Value="5" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="8">
							<ContentPresenter
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								TextBlock.FontFamily="Segoe UI" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#0071C5" />
								<Setter Property="Foreground" Value="#FFFFFF" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" Value="#005A9E" />
								<Setter Property="Foreground" Value="#F4F4F4" />
								<Setter Property="FontWeight" Value="Bold" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>

		</Style>

		<Style x:Key="MainWindowStyle" TargetType="Window">
			<Setter Property="Background" Value="#F4F4F4" />
		</Style>

		<Style x:Key="SettingsWindowStyle" TargetType="Window">
			<Setter Property="Background" Value="#F4F4F4" />
			<Setter Property="WindowStyle" Value="ToolWindow" />
			<Setter Property="Height" Value="600" />
			<Setter Property="Width" Value="500" />
			<Setter Property="ResizeMode" Value="NoResize" />
		</Style>

		<Style x:Key="SettingsTextbox" TargetType="TextBox">
			<Setter Property="Height" Value="{StaticResource ControlHeight30}" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{StaticResource TextBrush}" />
			<Setter Property="Background" Value="White" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>

		<Style x:Key="SettingsGroupBox" TargetType="GroupBox">
			<Setter Property="Background" Value="{StaticResource BackgroundMainBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
			<Setter Property="BorderThickness" Value="1.5" />
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="Margin" Value="0,0,0,10" />
			<Setter Property="HeaderTemplate">
				<Setter.Value>
					<DataTemplate>
						<Border
							Margin="0"
							Background="{StaticResource AccentColorBrush}"
							CornerRadius="2">
							<TextBlock
								Margin="2"
								Padding="2"
								FontSize="11"
								FontStyle="Italic"
								FontWeight="Bold"
								Foreground="{StaticResource MutedBlueBrush}"
								Text="{Binding}" />
						</Border>
					</DataTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SettingsPasswordBox" TargetType="PasswordBox">
			<Setter Property="Height" Value="{StaticResource ControlHeight30}" />
		</Style>

	</Application.Resources>
</Application>
